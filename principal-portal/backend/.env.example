NODE_ENV=development
PORT=3000

# PostgreSQL connection. Use a secret-managed DATABASE_URL in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=false
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=30000
DATABASE_APPLICATION_NAME=principal-portal-api
# Set true only when the managed provider supplies a verifiable CA chain.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_SEARCH_PATH=student,faculty,hod,principal,admin,dean,public,timetable,storage,pg_catalog
DATABASE_ALLOWED_SCHEMAS=student,faculty,hod,principal,admin,dean,public,timetable,storage

# Required only for approved administrative writes/imports/uploads.
# Anonymous dashboard and analytics GET requests do not use this key.
API_KEY=REPLACE_WITH_WRITE_API_KEY

# Keep disabled in production.
ALLOW_RAW_SQL=false
CORS_ORIGINS=http://localhost:5000,http://localhost:7357
