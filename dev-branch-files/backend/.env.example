NODE_ENV=development
PORT=3000

# AWS EC2 PostgreSQL connection
DATABASE_HOST=13.204.53.209
DATABASE_PORT=5432
DATABASE_NAME=ksrerp
DATABASE_USER=ksrce-user
DATABASE_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DATABASE_SSL=false
DATABASE_POOL_MAX=20
DATABASE_SEARCH_PATH=student,faculty,hod,principal,admin,dean,public,timetable,storage,pg_catalog
DATABASE_ALLOWED_SCHEMAS=student,faculty,hod,principal,admin,dean,public,timetable,storage

# Legacy DB_* names are supported by the PostgreSQL adapter when needed.
# DB_HOST=13.204.53.209
# DB_PORT=5432
# DB_NAME=ksrerp
# DB_USER=ksrce-user
# DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

# Use a long random value. Never commit backend/.env.
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# API_KEY=REPLACE_WITH_LONG_RANDOM_API_KEY

REQUIRE_AUTH=false
ALLOW_RAW_SQL=false
CORS_ORIGINS=http://localhost:5000,http://localhost:7357
